# Baseline format: "<file> <func>" (no line numbers). Unreachable from the
# phi binary by design; kept for API or external consumers.
cmd/exit.go exitError.silent

# ext/go/pxb wire helpers are a public SDK consumed by external extension
# binaries (and by the nested module's own tests, which deadcode -test cannot
# see from this module's roots). The ext/go/phi SDK is now outside this module's
# analysis entirely (nothing in the host imports it). msg_gen.go is generated by
# pxbgen, which deadcode skips, so those messages surface here only through the
# helpers they call.
ext/go/pxb/codec.go ByteReader.Blob
ext/go/pxb/codec.go ByteReader.Bool
ext/go/pxb/codec.go ByteReader.String
ext/go/pxb/codec.go ByteReader.Strings
ext/go/pxb/codec.go ByteReader.U32
ext/go/pxb/codec.go ByteReader.U64
ext/go/pxb/codec.go ByteReader.U8
ext/go/pxb/codec.go ByteWriter.Blob
ext/go/pxb/codec.go ByteWriter.Bool
ext/go/pxb/codec.go ByteWriter.Bytes
ext/go/pxb/codec.go ByteWriter.Grow
ext/go/pxb/codec.go ByteWriter.Reset
ext/go/pxb/codec.go ByteWriter.String
ext/go/pxb/codec.go ByteWriter.Strings
ext/go/pxb/codec.go ByteWriter.U16
ext/go/pxb/codec.go ByteWriter.U16s
ext/go/pxb/codec.go ByteWriter.U32
ext/go/pxb/codec.go ByteWriter.U64
ext/go/pxb/codec.go ByteWriter.U8
ext/go/pxb/codec.go DumpType
ext/go/pxb/codec.go ReadFrame
ext/go/pxb/fields.go FieldWriter.PutU16s
ext/go/pxb/fields.go FieldWriter.Reset
ext/go/pxb/fields.go u16sSize
